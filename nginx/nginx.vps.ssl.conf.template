# Template for the HTTPS-enabled nginx.vps.conf, rendered by
# scripts/setup-nginx-ssl.sh (plain `sed` substitution of the __DOMAIN__
# placeholder — deliberately not a `$`-prefixed token, so it can't collide
# with nginx's own `$variables`). Not mounted directly by any compose file;
# the script writes its rendered output OVER nginx/nginx.vps.conf, which is
# what docker-compose_vps.yml actually mounts. See that script and
# nginx/nginx.vps.conf's header comment for the full explanation of why
# Supabase's API paths are proxied here.
#
# Certificate paths below assume the standard certbot layout:
#   /etc/letsencrypt/live/__DOMAIN__/fullchain.pem
#   /etc/letsencrypt/live/__DOMAIN__/privkey.pem
# bind-mounted read-only into the nginx container from the host (see
# docker-compose_vps.yml's nginx service volumes).

worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    upstream app_upstream {
        server app:3001;
    }

    upstream admin_upstream {
        server admin:3002;
    }

    upstream landing_upstream {
        server landing:3000;
    }

    upstream supabase_upstream {
        server api-gw:8000;
    }

    # Plain HTTP: keep serving ACME challenges (renewals need this too),
    # redirect everything else to HTTPS.
    server {
        listen 80;
        server_name __DOMAIN__;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name __DOMAIN__;

        ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        # Next.js/Supabase auth cookie handling cares about these headers
        # being set correctly (Host, and the X-Forwarded-* pair), so every
        # location below sets the same proxy headers.

        location ~ ^/(auth|rest|storage|realtime|functions)/v1/ {
            proxy_pass http://supabase_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location /app/ {
            proxy_pass http://app_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location /admin/ {
            proxy_pass http://admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location / {
            proxy_pass http://landing_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
