# Template for the VPS's root .env — copy to .env.prod, fill in real
# secrets, then run scripts/vps-deploy.sh (which copies this to .env).
# Never commit the filled-in .env.prod (see .gitignore).
#
# These MUST match the same-named values in supabase/.env.prod exactly —
# generate them once there (sh supabase/utils/generate-keys.sh /
# add-new-auth-keys.sh, per supabase/.env.prod.example's own comments) and
# copy the results here, same as the local-dev .env/supabase/.env split.

# --- Supabase (must match supabase/.env.prod) ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-min-32-chars
ANON_KEY=
SERVICE_ROLE_KEY=

# DATABASE_URL/SUPABASE_URL below are only used by host-run `pnpm dev`
# (not applicable on a VPS) — docker-compose_vps.yml always overrides both
# for app/admin/worker to point at the "db"/"api-gw" container-network
# services directly, so the values here are effectively unused at
# container runtime. Left populated for consistency/reference only.
DATABASE_URL=postgresql://postgres:change-me@db:5432/postgres
SUPABASE_URL=http://api-gw:8000

# NEXT_PUBLIC_* vars are inlined into the app/admin client bundles at
# IMAGE BUILD TIME (see apps/app/Dockerfile, apps/admin/Dockerfile) — they
# are NOT read at container runtime, so editing them here has no effect on
# already-built images. Set them as --build-arg values when you build/push
# (README "VPS deployment"); keep them here too so the values used for the
# most recent build are recorded and easy to reuse for the next build.
# Must be your public https://<domain> (no port) — see
# nginx/nginx.vps.conf's header comment for why.
NEXT_PUBLIC_SUPABASE_URL=https://your-domain.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — read at runtime, safe to change without rebuilding images.
SUPABASE_SERVICE_ROLE_KEY=

# --- App secrets ---
# Generate with scripts/generate-aes-key.sh
AES_MASTER_KEY=

# Server-only OpenAI key backing the 'platform' embeddings provider (Free
# plan / default). Required for Free-plan chatbots to ingest documents;
# BYOK-configured chatbots (their own OpenAI/Anthropic key) don't need it.

# --- Image tags consumed by docker-compose_vps.yml ---
# Where you pushed the prebuilt cbb-app/cbb-admin/cbb-landing images to
# (README "VPS deployment" for the build+push commands), and which tag to
# pull. Defaults (ghcr.io/example:latest) are placeholders — set REGISTRY
# to your own registry/namespace before your first real push.
REGISTRY=ghcr.io/example
TAG=latest

# --- nginx / SSL (read and updated by scripts/setup-nginx-ssl.sh) ---
DOMAIN=your-domain.example.com
CERTBOT_EMAIL=you@example.com
SSL_ENABLED=false
