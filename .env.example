# --- Supabase (self-hosted, see supabase/.env for the full vendored set) ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-min-32-chars
ANON_KEY=
SERVICE_ROLE_KEY=

# For host-run `pnpm dev` against the supabase/docker-compose.yml stack:
# Supavisor (the pooler) is what's exposed to the host on :5432, and it
# requires the tenant-qualified username postgres.<POOLER_TENANT_ID>
# (POOLER_TENANT_ID is set in supabase/.env, default "your-tenant-id").
# Inside docker-compose.yml's own "containers" profile, app/admin/worker
# instead connect straight to the "db" service by name, plain "postgres" user.
DATABASE_URL=postgresql://postgres.your-tenant-id:change-me@localhost:5432/postgres
SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used for Storage uploads/reads from Server Actions/Route
# Handlers (files are proxied through the Next.js server, not uploaded
# client-side, so we don't need per-object Storage RLS policies). Never
# expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- App secrets ---
# Generate with scripts/generate-aes-key.sh
AES_MASTER_KEY=

# Every chatbot is BYOK-only (chat + embeddings) — there is no
# platform-managed provider key, so there's nothing to configure here.

# --- nginx / routing ---
APP_UPSTREAM=host.docker.internal:3001
ADMIN_UPSTREAM=host.docker.internal:3002
LANDING_UPSTREAM=host.docker.internal:3000
SSL_ENABLED=false
DOMAIN=localhost
